# SafeLine 管理 API
SAFELINE_BASE_URL=https://127.0.0.1:9443
SAFELINE_API_TOKEN=
SAFELINE_TOKEN_HEADER=X-SLCE-API-TOKEN
SAFELINE_ALLOW_MUTATIONS=false
SAFELINE_ALLOW_SENSITIVE=false
SAFELINE_INSECURE_TLS=false
SAFELINE_TIMEOUT_MS=15000

# MCP Streamable HTTP 服务
MCP_AUTH_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=3000
# 多个值用逗号分隔
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
